{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deck_id",
    "brief_id",
    "core_answer",
    "storyline",
    "slide_ids",
    "canvas"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "core_answer": {
      "type": "string",
      "minLength": 1
    },
    "storyline": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slide_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_in",
        "height_in"
      ],
      "properties": {
        "width_in": {
          "type": "number",
          "minimum": 2,
          "maximum": 56
        },
        "height_in": {
          "type": "number",
          "minimum": 2,
          "maximum": 56
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "layout_part"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "layout_part": {
          "type": "string"
        }
      }
    }
  }
}