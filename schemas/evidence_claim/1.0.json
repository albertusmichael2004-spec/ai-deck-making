{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "type",
    "text",
    "supported_by",
    "confidence",
    "assumptions",
    "schema_version"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
    },
    "type": {
      "enum": [
        "interpretation",
        "hypothesis",
        "recommendation"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "supported_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}