{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "display_name", "created_at", "last_opened_at", "last_chat_started_at", "last_chat_exit_code", "imports"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "created_at": {"type": "string"},
    "last_opened_at": {"type": ["string", "null"]},
    "last_chat_started_at": {"type": ["string", "null"]},
    "last_chat_exit_code": {"type": ["integer", "null"]},
    "category": {"enum": ["project", "others"]},
    "export": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "generation"], "properties": {
      "path": {"type": "string"},
      "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
      "generation": {"type": ["integer", "null"], "minimum": 1}
    }},
    "imports": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "original_path", "path", "relative_path", "sha256", "bytes", "imported_at"],
      "properties": {
        "role": {"enum": ["source", "asset", "target", "reference"]},
        "original_path": {"type": "string"},
        "path": {"type": "string"},
        "relative_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "imported_at": {"type": "string"}
      }
    }}
  }
}
