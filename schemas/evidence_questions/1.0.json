{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "question_id",
      "question",
      "evidence_ids"
    ],
    "properties": {
      "question_id": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
        }
      },
      "material": {
        "type": "boolean"
      },
      "max_age_days": {
        "type": "integer",
        "minimum": 0
      },
      "minimum_confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "accepted_types": {
        "type": "array",
        "items": {
          "enum": [
            "raw_fact",
            "calculated_fact",
            "interpretation",
            "hypothesis",
            "recommendation"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}