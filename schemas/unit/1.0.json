{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label"
  ],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "transformation": {
      "type": "string"
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": -4,
        "maximum": 4
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}