{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "generation",
    "canonical",
    "canonical_fingerprint",
    "authority",
    "validation_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "canonical": {
      "const": "presentation/canonical.pptx"
    },
    "canonical_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists",
        "sha256",
        "mtime_ns",
        "bytes"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "mtime_ns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "authority": {
      "enum": [
        "file",
        "live"
      ]
    },
    "validation_policy": {
      "enum": [
        "presentation",
        "kernel"
      ]
    }
  }
}