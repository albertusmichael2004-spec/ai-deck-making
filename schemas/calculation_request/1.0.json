{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calculation_id",
    "formula",
    "inputs",
    "unit",
    "schema_version"
  ],
  "properties": {
    "calculation_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
    },
    "formula": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,127}$"
      }
    },
    "unit": {
      "$ref": "../unit/1.0.json"
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}