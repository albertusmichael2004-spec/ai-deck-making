{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studio: Run directly",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/run.py", "--in-terminal"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {"PYTHONUTF8": "1"}
      },
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated"},
      "problemMatcher": []
    },
    {
      "label": "Studio: Install VS Code extension (Run button + Deck Preview)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/install_vscode_extension.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "shared"},
      "problemMatcher": []
    }
  ]
}
